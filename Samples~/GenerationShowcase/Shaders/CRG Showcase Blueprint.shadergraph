{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "e44212f7670f42b2bf2c62f83b8579b0",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "CRGShowcaseBlueprint (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -500.0,
            "y": 0.0,
            "width": 260.0,
            "height": 200.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "0f87c4fbb141459ea0a724580af5e6de"
        },
        {
            "m_Id": "37c1871c088c47528b26a134c332e1e2"
        },
        {
            "m_Id": "4b19c832b08142cab039046523b1d3b1"
        },
        {
            "m_Id": "54f90b80be6a491c805ac4bfe3300205"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "CRGShowcaseBlueprint",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Blueprint outlines: additive glow whose strength is _LineAlpha (set per room by the showcase), with a slow shimmer\n// running across the level so the lines feel alive.\nfloat shimmer = 0.8 + 0.2 * sin(_Time.y * 4.0 + (WorldPosition.x + WorldPosition.z) * 0.35);\nBaseColor = _LineColor.rgb * _LineAlpha * shimmer;\nAlpha = _LineAlpha;"
}

